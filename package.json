  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "test-ci": "jest --config jest.config.cjs --coverage --ci --silent --reporters=jest-junit --reporters=default --coverageReporters=lcov --coverageReporters=cobertura",
    "test": "jest --config jest.config.cjs",
    "test:staged-files": "npm run test -- --bail --findRelatedTests --passWithNoTests",
    "coverage": "npm run test -- --coverage --ci --silent --watchAll=false --reporters=jest-junit --reporters=default --coverageReporters=cobertura --coverageReporters=lcov",
    "serve": "vite preview --port 8080 --strictPort",
    "dev": "vite --port 8080 --strictPort",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint ./src",
    "build:module": "rollup -c",
    "generate": "plop",
    "husky:prepare": "husky",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules/"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
