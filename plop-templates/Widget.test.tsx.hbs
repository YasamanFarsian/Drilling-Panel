import { waitFor } from '@testing-library/react';
import React from 'react';
import { mockedSignalR } from '@/helpers/tests/mock/signalR';
import renderWithThemeAndLocaleProviders from '@/helpers/tests/renderWithContext';
import ConfigsProvider from '@/providers/Configs';
import NoStreamingTimerChartGroupProvider from '@/providers/NoStreamingTimerChartGroup';
import ReconnectingChartGroupProvider from '@/providers/ReconnectingChartGroup';
import { WidgetsLoaderEnum } from '@/store/UserConfiguration/UserConfiguration.types';
import {{pascalCase name}} from './{{pascalCase name}}';

mockedSignalR();
describe('{{pascalCase name}}', () => {
  it('should render without crashing', () => {
    const { getByTestId } = renderWithThemeAndLocaleProviders(
      <ConfigsProvider>
        <ReconnectingChartGroupProvider>
          <NoStreamingTimerChartGroupProvider>
            <{{pascalCase name}} />
          </NoStreamingTimerChartGroupProvider>
        </ReconnectingChartGroupProvider>
      </ConfigsProvider>,
    );
    expect(getByTestId('baseWidget_{{pascalCase name}}')).toBeInTheDocument();          
    expect(
      getByTestId(`container_${ WidgetsLoaderEnum.{{pascalCase name}} }`),
    ).toBeInTheDocument();   
    expect(getByTestId('loading-dark')).toBeInTheDocument(); 
  });
  it('should not render loader', async () => {
    const { queryByRole } = renderWithThemeAndLocaleProviders(
      <ConfigsProvider>
        <ReconnectingChartGroupProvider>
          <NoStreamingTimerChartGroupProvider>
            <{{pascalCase name}} />
          </NoStreamingTimerChartGroupProvider>
        </ReconnectingChartGroupProvider>
      </ConfigsProvider>,
    );
    await waitFor(() => expect(queryByRole('loading-dark')).not.toBeInTheDocument());
  });
});
